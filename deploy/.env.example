# Optional. Docker Compose starts without this file: every value below has a local default (ADR-0034). Copy it to
# deploy/.env (git-ignored) and set your own values for anything beyond trying the system out on this machine.
#
# The defaults are public, so the API then listens on this machine only. Change the passwords before you set
# API_ADDRESS=0.0.0.0. The broker and database keep the passwords they were first created with: after changing them,
# remove the volumes once (docker compose -f deploy/compose.yaml down --volumes).

# RabbitMQ and PostgreSQL accounts used by the API and the engines.
MESSAGING_USER=elevator
MESSAGING_PASSWORD=elevator-local-broker
DATABASE_USER=elevator
DATABASE_PASSWORD=elevator-local-database

# A test admin that signs in with its password only, no authenticator app (ADR-0030). This password is public: it is
# for trying the system out. Set TEST_ADMIN_PASSWORD empty to turn the test account off.
TEST_ADMIN_EMAIL=tester@elevator.local
TEST_ADMIN_PASSWORD=elevator-test-account

# A real admin, created once when ADMIN_PASSWORD is set: at least 12 characters, with at least 4 different ones. The
# first sign-in registers an authenticator app and shows recovery codes.
ADMIN_EMAIL=admin@elevator.local
ADMIN_PASSWORD=

# Pseudonymises client addresses in the audit trail: 44 base64 characters (openssl rand -base64 33). Without one,
# pseudonyms link only until the API restarts.
AUDIT_PSEUDONYM_KEY=

# The HTTPS certificate. Without CERTIFICATE_DIR the API makes a self-signed one for localhost on first start (the
# browser warns once). To use your own, point CERTIFICATE_DIR at a folder holding elevator.pfx, relative to deploy/,
# for example ./certs with the .NET development certificate (see deploy/README.md).
CERTIFICATE_DIR=
CERTIFICATE_PASSWORD=elevator-local-certificate

# Where the API listens: 127.0.0.1 (this machine) by default, 0.0.0.0 for your network.
API_ADDRESS=127.0.0.1

# The order the car serves its calls in: Fifo (the requirement) or Look, to compare average wait times (ADR-0005).
ELEVATOR_SCHEDULING=Fifo
