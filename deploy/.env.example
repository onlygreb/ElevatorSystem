# Copy to deploy/.env (git-ignored) and fill in every value. Nothing here is a real secret.

# RabbitMQ and PostgreSQL accounts used by the API and the engines.
MESSAGING_USER=elevator
MESSAGING_PASSWORD=
DATABASE_USER=elevator
DATABASE_PASSWORD=

# The first admin: at least 12 characters, with at least 4 different ones. The account is created once, so keep it.
ADMIN_EMAIL=admin@elevator.local
ADMIN_PASSWORD=

# Pseudonymises client addresses in the audit trail: 44 base64 characters (openssl rand -base64 33).
AUDIT_PSEUDONYM_KEY=

# Password of deploy/certs/elevator.pfx, the HTTPS certificate the API serves (see deploy/README.md).
CERTIFICATE_PASSWORD=

# A test admin that signs in with its password only, no authenticator app (ADR-0030). This password is public: it is
# for trying the system out. Leave TEST_ADMIN_PASSWORD empty to turn the test account off.
TEST_ADMIN_EMAIL=tester@elevator.local
TEST_ADMIN_PASSWORD=elevator-test-account
