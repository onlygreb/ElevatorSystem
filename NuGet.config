<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply-chain hardening: restore only from nuget.org, and map every package to that source
  so a same-named package on another feed can never be picked up (dependency confusion).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
