{
  "stryker-config": {
    "project": "ElevatorSystem.Application.csproj",
    "test-runner": "mtp",
    "reporters": ["progress", "html", "json"],
    "mutate": [
      "**/ElevatorController.cs",
      "**/ElevatorContractMapper.cs",
      "**/CompositeElevatorEventSink.cs",
      "**/RequestResult.cs",
      "**/Passengers/PassengerRegistry.cs",
      "**/Audit/AuditChain.cs",
      "**/Audit/AuditTrail.cs",
      "**/Audit/ClientPseudonymizer.cs"
    ],
    "ignore-methods": ["ThrowIfNull", "*Exception.ctor", "Log.*", "*Log.*"],
    "additional-timeout": 10000,
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 80
    }
  }
}
