<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    Blazor WebAssembly UI (passenger view + admin panel). Runs in the browser and talks only to the
    API, so every rule is enforced server-side. May reference Contracts only (architecture tests).
  -->
  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- en-US lives in the main assembly; pt-BR ships as a satellite assembly. -->
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- Culture-aware formatting of dates and numbers for every supported culture, not only the browser's. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElevatorSystem.Contracts\ElevatorSystem.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ElevatorSystem.Web.Tests" />
  </ItemGroup>
</Project>
