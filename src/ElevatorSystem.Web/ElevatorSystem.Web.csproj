<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    Blazor WebAssembly UI (passenger view + admin panel). Runs in the browser and talks only to the
    API, so every rule is enforced server-side. May reference Contracts only (architecture tests).
  -->
  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElevatorSystem.Contracts\ElevatorSystem.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>
</Project>
