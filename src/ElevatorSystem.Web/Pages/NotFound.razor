@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L[Text.NotFoundTitle]</PageTitle>

<MudPaper Class="es-panel" Elevation="0">
    <h1 class="es-panel__title" tabindex="-1">@L[Text.NotFoundTitle]</h1>
    <p class="es-panel__hint">@L[Text.NotFoundText]</p>
    <MudButton Href="" Variant="Variant.Outlined" Color="Color.Primary">@L[Text.BackHome]</MudButton>
</MudPaper>
