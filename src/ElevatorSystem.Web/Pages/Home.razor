@page "/"
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L[Text.PageTitle]</PageTitle>

<h1 class="visually-hidden" tabindex="-1">@L[Text.PageTitle]</h1>

<ErrorBoundary>
    <ChildContent>
        <PassengerView />
    </ChildContent>
    <ErrorContent>
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" role="alert">@L[Text.UnhandledError]</MudAlert>
    </ErrorContent>
</ErrorBoundary>
