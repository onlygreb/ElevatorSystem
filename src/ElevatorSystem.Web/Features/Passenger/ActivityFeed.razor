@* Recent activity, newest first, rendered from the hub's ElevatorActivityDto stream; your own steps are marked. *@
@inject IStringLocalizer<SharedResource> L

@if (Activity.Count == 0)
{
    <p class="es-empty">@L[Text.ActivityEmpty]</p>
}
else
{
    @* Scrollable, so it must be reachable by keyboard (WCAG 2.1.1). *@
    <div class="activity-scroll" tabindex="0" role="region" aria-labelledby="@LabelledBy">
        <ol class="activity">
            @foreach (var activity in Activity)
            {
                var mine = You is { } you && activity.PassengerId == you;
                var itemClass = "activity__item activity__item--" + Tone(activity) + (mine ? " activity__item--mine" : string.Empty);
                <li class="@itemClass" data-kind="@activity.Kind">
                    <span class="activity__icon" aria-hidden="true">@Icon(activity)</span>
                    <span class="activity__text">
                        @if (mine)
                        {
                            <span class="activity__you">@L[Text.YouLabel]</span>
                        }
                        else if (activity.Simulated == true)
                        {
                            <span class="activity__demo">@L[Text.DemoTag]</span>
                        }
                        @L.Describe(activity)
                    </span>
                    <time class="activity__time" datetime="@activity.OccurredAt.ToString("O", CultureInfo.InvariantCulture)">@Narration.Time(activity)</time>
                </li>
            }
        </ol>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<ElevatorActivityDto> Activity { get; set; } = [];

    /// <summary>Id of the heading that names the feed.</summary>
    [Parameter]
    public string? LabelledBy { get; set; }

    /// <summary>The viewing passenger, whose own steps are marked.</summary>
    [Parameter]
    public Guid? You { get; set; }

    private static string Tone(ElevatorActivityDto activity) => activity.Kind switch
    {
        ElevatorActivityKind.RequestRejected or ElevatorActivityKind.PassengerRefused or ElevatorActivityKind.OutOfService => "alert",
        ElevatorActivityKind.Moved => "move",
        ElevatorActivityKind.DoorsOpened or ElevatorActivityKind.DoorsClosed => "door",
        ElevatorActivityKind.CallServed or ElevatorActivityKind.ReturnedToService => "good",
        ElevatorActivityKind.SpeedChanged => "move",
        ElevatorActivityKind.RequestsCleared => "alert",
        ElevatorActivityKind.SchedulingChanged => "call",
        >= ElevatorActivityKind.PassengerJoined => "person",
        _ => "call",
    };

    private static string Icon(ElevatorActivityDto activity) => activity.Kind switch
    {
        ElevatorActivityKind.Moved => activity.Direction == CallDirection.Down ? "▼" : "▲",
        ElevatorActivityKind.DoorsOpened => "⇤⇥",
        ElevatorActivityKind.DoorsClosed => "⇥⇤",
        ElevatorActivityKind.CallServed => "✓",
        ElevatorActivityKind.RequestRejected or ElevatorActivityKind.PassengerRefused => "!",
        ElevatorActivityKind.OutOfService => "■",
        ElevatorActivityKind.ReturnedToService => "▶",
        ElevatorActivityKind.PassengerJoined => "+",
        ElevatorActivityKind.PassengerBoarded => "→",
        ElevatorActivityKind.PassengerLeft => "←",
        ElevatorActivityKind.PassengerRemoved => "−",
        ElevatorActivityKind.SpeedChanged => "»",
        ElevatorActivityKind.RequestsCleared => "✕",
        ElevatorActivityKind.SchedulingChanged => "⇅",
        _ => "•",
    };
}
