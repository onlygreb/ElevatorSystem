@* The building: one landing per floor (top floor first) beside the shaft, where the car moves by CSS transform. *@
@inject IStringLocalizer<SharedResource> L

<div class="building" style="--es-floor-count: @FloorCount">
    <ol class="landings" aria-label="@L[Text.FloorsHeading]">
        @for (var floor = Configuration.HighestFloor; floor >= Configuration.LowestFloor; floor--)
        {
            var current = floor == Status?.CurrentFloor;
            <li class="landing@(current ? " landing--current" : null)" data-floor="@floor" aria-current="@(current ? "location" : null)">
                <span class="landing__marker" aria-hidden="true"></span>
                <span class="landing__number" aria-hidden="true">@floor</span>
                <div class="hall-buttons" role="group" aria-label="@L[Text.HallButtonsLabel, floor]">
                    @if (floor < Configuration.HighestFloor)
                    {
                        <HallButton Floor="floor" Direction="CallDirection.Up" Lit="IsHallCallPending(floor, CallDirection.Up)" OnPress="OnHallCall" />
                    }
                    else
                    {
                        <span class="hall-button-gap" aria-hidden="true"></span>
                    }
                    @if (floor > Configuration.LowestFloor)
                    {
                        <HallButton Floor="floor" Direction="CallDirection.Down" Lit="IsHallCallPending(floor, CallDirection.Down)" OnPress="OnHallCall" />
                    }
                    else
                    {
                        <span class="hall-button-gap" aria-hidden="true"></span>
                    }
                </div>
            </li>
        }
    </ol>

    <div class="shaft" role="img" aria-label="@CarDescription">
        <div class="@CarClasses" style="@CarStyle" data-floor="@CarFloor">
            <div class="car__display" aria-hidden="true">
                @if (Status?.Status == ElevatorStatus.MovingUp)
                {
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M12 5 20 18H4Z" /></svg>
                }
                else if (Status?.Status == ElevatorStatus.MovingDown)
                {
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M12 19 4 6H20Z" /></svg>
                }
                <span>@CarFloor</span>
            </div>
            <div class="car__doorway" aria-hidden="true">
                <span class="door door--left"></span>
                <span class="door door--right"></span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ElevatorConfigurationDto Configuration { get; set; } = default!;

    [Parameter]
    public ElevatorStatusDto? Status { get; set; }

    [Parameter]
    public EventCallback<HallCallRequest> OnHallCall { get; set; }

    private int FloorCount => Configuration.HighestFloor - Configuration.LowestFloor + 1;

    // Before the first status arrives the car waits, doors closed, at the lowest floor.
    private int CarFloor => Math.Clamp(Status?.CurrentFloor ?? Configuration.LowestFloor, Configuration.LowestFloor, Configuration.HighestFloor);

    private bool DoorsOpen => Status?.Status == ElevatorStatus.DoorOpen;

    private string CarClasses =>
        "car"
        + (DoorsOpen ? " car--doors-open" : " car--doors-closed")
        + (Status?.Status == ElevatorStatus.OutOfService ? " car--out-of-service" : null);

    // One floor per move, so each move animates over exactly the configured travel time per floor.
    private string CarStyle => string.Create(
        CultureInfo.InvariantCulture,
        $"transform: translateY(calc({-(CarFloor - Configuration.LowestFloor)} * var(--es-floor-height))); transition-duration: {(long)Configuration.TravelTimePerFloor.TotalMilliseconds}ms");

    private string CarDescription => L[Text.CarDescription, CarFloor, L[DoorsOpen ? Text.DoorsOpen : Text.DoorsClosed]];

    private bool IsHallCallPending(int floor, CallDirection direction) =>
        Status?.PendingCalls.Any(pending =>
            pending.Call is { Kind: CallKind.Hall } call && call.Floor == floor && call.Direction == direction) == true;
}
